server {
    server_name ai.256.co.ug;

    real_ip_header CF-Connecting-IP;
    set_real_ip_from 0.0.0.0/0;

    location = /news { proxy_pass http://127.0.0.1:5066/api/platforms/256-ai/news-page; proxy_set_header Host $host; }
    location ~ ^/news/([^/]+)$ { proxy_pass http://127.0.0.1:5066/api/platforms/256-ai/news-page/$1; proxy_set_header Host $host; }

    location / {
        proxy_pass http://127.0.0.1:5025;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_cache_bypass $http_upgrade;
        proxy_read_timeout 180s;
        proxy_send_timeout 180s;
        proxy_buffering off;
    }

    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/social.256.co.ug/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/social.256.co.ug/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot

}
server {
    if ($host = ai.256.co.ug) {
        return 301 https://$host$request_uri;
    } # managed by Certbot


    listen 80;
    server_name ai.256.co.ug;
    return 404; # managed by Certbot


}
